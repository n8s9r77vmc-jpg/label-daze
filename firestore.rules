rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.owner || (request.auth != null && request.auth.uid == request.resource.data.owner);
    }
    // default deny
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
