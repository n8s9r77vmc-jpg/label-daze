rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products collection: users can create documents where owner == request.auth.uid
    // and can read/update/delete only documents they own.
    match /products/{productId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.owner;
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.owner;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
